{
  "name": "ai-ops-dashboard",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Local React/Vite console for tracking Claude Code vs Codex usage, plan pressure, routing decisions, productivity, and personal finance baselines. No backend, no telemetry.",
  "license": "MIT",
  "author": "Gustavo Magnago (https://github.com/gusmagnago)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusmagnago/ai-ops-dashboard.git"
  },
  "homepage": "https://github.com/gusmagnago/ai-ops-dashboard#readme",
  "bugs": {
    "url": "https://github.com/gusmagnago/ai-ops-dashboard/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "ai-ops",
    "dashboard",
    "observability",
    "usage-tracking",
    "cost-optimization"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "ingest": "node scripts/ingest-usage.mjs",
    "ingest:watch": "node scripts/ingest-usage.mjs --watch",
    "ingest:finance": "node scripts/ingest-finance.mjs",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "setup": "node scripts/setup.mjs",
    "sync": "node scripts/sync-context.mjs",
    "sync:check": "node scripts/sync-context.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.2.7",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^2.1.9"
  }
}
