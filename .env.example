# Example environment for the optional examples/slack-obsidian scripts.
# Copy this to .env.local and fill in only if you adapt those scripts.

OBSIDIAN_VAULT_PATH=""
AI_OPS_TIMEZONE="Europe/Lisbon"

# Optional: post the daily digest to Slack.
SLACK_WEBHOOK_URL=""
SLACK_DIGEST_OFFSET_DAYS="1"
SLACK_DIGEST_DATE=""

# Optional: expose Slack shortcut capture through a tunnel.
SLACK_CAPTURE_HOST="127.0.0.1"
SLACK_CAPTURE_PORT="4141"
SLACK_SIGNING_SECRET=""
AI_OPS_CAPTURE_TOKEN=""
